{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (C++)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Debug/MyApp.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "E:/vsc/winlib_gcc_16_20/bin/gdb.exe", // 引用你已配置的路径
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Release (No Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Release/MyApp.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "E:/vsc/winlib_gcc_16_20/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-release"
        }
    ]
}